// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URL moved to `prisma.config.ts` (Prisma v7+).
  // See https://pris.ly/d/config-datasource
}


enum UserRole {
  ADMIN
  NON_ADMIN
}

enum NonAdminProfile {
  PROF
  DELEGUE
  CLUB_PRESIDENT
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  DECLINED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum ReservationRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  OVERRIDDEN
  CANCELLED
}

enum ReservationStatus {
  APPROVED
  CANCELLED
}

enum ReservationKind {
  MANUAL
  STANDARD_SCHEDULE
}

enum PeriodOfDay {
  ANY
  BEFORE_MIDDAY
  AFTER_MIDDAY
}

model Department {
  id        String @id @default(cuid())
  name      String @unique
  code      String @unique

  admins          User[]     @relation("DepartmentAdmins")
  categoriesOwned Category[] @relation("CategoryOwnerDepartment")
  ticketsAssigned Ticket[]   @relation("TicketAssignedDepartment")

  // opposite for CategoryVisibility.department
  categoryVisibilities CategoryVisibility[] @relation("CategoryVisibilityDepartment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String @id @default(cuid())
  email     String @unique
  password  String
  fullName  String

  role      UserRole
  profile   NonAdminProfile?

  departmentId String?
  department   Department? @relation("DepartmentAdmins", fields: [departmentId], references: [id])

  createdTickets Ticket[] @relation("TicketCreatedBy")
  assignedTickets Ticket[] @relation("TicketAssignedTo")
  ticketComments TicketComment[]

  // opposite for ReservationRequest.processedBy
  processedReservationRequests ReservationRequest[] @relation("ReservationRequestProcessedBy")

  // opposite for Reservation.createdBy
  createdReservations Reservation[] @relation("ReservationCreatedBy")

  // opposite for ImportBatch.importedBy
  importBatches ImportBatch[] @relation("ImportBatchImportedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([profile])
  @@index([departmentId])
}

model Category {
  id          String @id @default(cuid())
  name        String
  code        String @unique
  description String?

  ownerDepartmentId String
  ownerDepartment   Department @relation("CategoryOwnerDepartment", fields: [ownerDepartmentId], references: [id])

  visibilities CategoryVisibility[]
  tickets       Ticket[]

  isOther       Boolean @default(false)
  isReservation Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, ownerDepartmentId])
  @@index([ownerDepartmentId])
  @@index([isOther])
  @@index([isReservation])
}

model CategoryVisibility {
  id         String @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  profile    NonAdminProfile?

  departmentId String?
  department   Department? @relation("CategoryVisibilityDepartment", fields: [departmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([categoryId])
  @@index([profile])
  @@index([departmentId])

  @@unique([categoryId, profile, departmentId])
}

model Ticket {
  id            String @id @default(cuid())

  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])

  subtype       String?
  description   String

  status        TicketStatus @default(NEW)

  priority      TicketPriority?
  aiReason      String?

  createdById   String
  createdBy     User @relation("TicketCreatedBy", fields: [createdById], references: [id])

  assignedDepartmentId String
  assignedDepartment   Department @relation("TicketAssignedDepartment", fields: [assignedDepartmentId], references: [id])

  assignedToId String?
  assignedTo   User? @relation("TicketAssignedTo", fields: [assignedToId], references: [id])

  comments      TicketComment[]

  reservationRequest ReservationRequest?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdById])
  @@index([assignedDepartmentId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([categoryId])
}

model TicketComment {
  id        String @id @default(cuid())
  ticketId  String
  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId  String
  author    User @relation(fields: [authorId], references: [id])

  body      String

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([authorId])
}

model Campus {
  id        String @id @default(cuid())
  name      String
  code      String @unique

  rooms     Room[]

  // opposites for ReservationRequest.campus and Reservation.campus
  reservationRequests ReservationRequest[] @relation("ReservationRequestCampus")
  reservations        Reservation[]        @relation("ReservationCampus")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoomType {
  id        String @id @default(cuid())
  name      String
  code      String @unique

  rooms     Room[]
}

model Room {
  id        String @id @default(cuid())
  name      String
  code      String @unique

  campusId  String
  campus    Campus @relation(fields: [campusId], references: [id])

  roomTypeId String?
  roomType   RoomType? @relation(fields: [roomTypeId], references: [id])

  capacity  Int?

  reservations        Reservation[]
  reservationRequests ReservationRequest[]
  slotDemands         RoomSlotDemand[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campusId])
  @@index([roomTypeId])
}

model ReservationRequest {
  id        String @id @default(cuid())

  ticketId  String @unique
  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  status    ReservationRequestStatus @default(PENDING)

  roomId    String
  room      Room @relation(fields: [roomId], references: [id])

  campusId  String
  campus    Campus @relation("ReservationRequestCampus", fields: [campusId], references: [id])

  startAt   DateTime
  endAt     DateTime

  adminCanAdjust Boolean @default(false)

  periodOfDay PeriodOfDay @default(ANY)

  processedById String?
  processedBy   User? @relation("ReservationRequestProcessedBy", fields: [processedById], references: [id])

  processedAt   DateTime?
  adminNote     String?

  // reservation created when accepted / overridden (optional)
  approvedReservationId String? @unique
  approvedReservation   Reservation? @relation("RequestApprovedReservation", fields: [approvedReservationId], references: [id])

  // opposite for Reservation.createdFromRequest
  reservationCreated Reservation? @relation("ReservationCreatedFromRequestOpposite")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([roomId, startAt, endAt])
  @@index([campusId, startAt, endAt])
  @@index([processedById])
}

model Reservation {
  id        String @id @default(cuid())

  kind      ReservationKind @default(MANUAL)
  status    ReservationStatus @default(APPROVED)

  roomId    String
  room      Room @relation(fields: [roomId], references: [id])

  campusId  String
  campus    Campus @relation("ReservationCampus", fields: [campusId], references: [id])

  startAt   DateTime
  endAt     DateTime

  description String

  isRecurring Boolean @default(false)
  recurrenceEndDate DateTime?

  // Created from request (optional)
  createdFromRequestId String? @unique
  createdFromRequest   ReservationRequest? @relation("ReservationCreatedFromRequestOpposite", fields: [createdFromRequestId], references: [id])

  // Link back from ReservationRequest.approvedReservation
  approvedByRequest ReservationRequest? @relation("RequestApprovedReservation")

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  createdById String?
  createdBy   User? @relation("ReservationCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId, startAt, endAt])
  @@index([campusId, startAt, endAt])
  @@index([status])
  @@index([kind])
  @@index([importBatchId])
}

model ImportBatch {
  id            String @id @default(cuid())
  fileName      String

  importedById  String
  importedBy    User @relation("ImportBatchImportedBy", fields: [importedById], references: [id])

  madeRecurringAt   DateTime?
  recurrenceEndDate DateTime?

  reservations  Reservation[]

  createdAt DateTime @default(now())

  @@index([importedById])
}

model RoomSlotDemand {
  id              String @id @default(cuid())

  roomId          String
  room            Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  slotStartMinute Int
  durationMinutes Int

  requestCount    Int @default(0)
  lastRequestedAt DateTime?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([roomId, slotStartMinute, durationMinutes])
  @@index([roomId])
  @@index([slotStartMinute, durationMinutes])
}